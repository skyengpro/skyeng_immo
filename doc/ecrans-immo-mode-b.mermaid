---
title: "Mode B, A customer owns an instance : écrans de l'application et flux avec le desk"
---
flowchart TB
    classDef desk fill:#f3eefb,stroke:#7a5bc0,color:#2f2350,text-align:left
    classDef bailleur fill:#e8f0fe,stroke:#3b6fd6,color:#1a2b4c,text-align:left
    classDef locataire fill:#e3f4ec,stroke:#2e8b62,color:#173d2c,text-align:left
    classDef commun fill:#fdf3e1,stroke:#c08a2e,color:#4a3510,text-align:left
    classDef legende fill:#ffffff,stroke:#9a9a9a,color:#333333,text-align:left

    subgraph DSK["Desk : équipe du client (System Manager / Property Manager)"]
        D1["<b>Bailleurs tiers (facultatif)</b><br/>- Un Customer par propriétaire tiers<br/>- Les biens du client ont la société<br/>du client comme propriétaire"]
        D2["<b>Biens</b><br/>- Arbre : immeuble, puis lots<br/>- Propriétaire (unit_owner) sur chaque bien"]
        D3["<b>Baux et échéanciers</b><br/>- Locataire, loyer, rythme, caution<br/>- Factures générées chaque jour<br/>par PropMS, puis validées"]
        D4["<b>Comptes</b><br/>- Comptes locataires<br/>- Comptes des bailleurs tiers<br/>- Envoi des invitations"]
        D5["<b>Paiements reçus</b><br/>- Enregistrés sur la facture<br/>(espèces, virement, MoMo hors application)"]
        D6["<b>Demandes de maintenance</b><br/>- Traitement et mise à jour du statut"]
    end

    MAIL["<b>E-mails</b><br/>- Invitation<br/>- Rappel avant échéance (locataire)<br/>- Reçu (locataire)<br/>- Avis de paiement (bailleur tiers)"]

    C0["<b>Connexion</b><br/>- Lien d'invitation, ou compte du desk pour le gestionnaire<br/>- Le rôle choisit l'écran d'accueil"]

    subgraph BAI["Application : gestionnaire et bailleur tiers (consultation seule)"]
        B1["<b>1. Accueil</b><br/>- Nombre de biens et de locataires<br/>- Encaissé du mois, total impayé<br/>- Factures en retard"]
        B2["<b>2. Mes biens</b><br/>- Arbre par immeuble<br/>- Par lot : statut, locataire, loyer<br/>- Gestionnaire : tous les biens,<br/>regroupés par bailleur"]
        B3["<b>3. Bien</b><br/>- Bail en cours, locataires, date d'entrée<br/>- Caution, échéancier<br/>- Factures payées et dues, anciens baux"]
        B4["<b>4. Locataire</b><br/>- Conditions du bail<br/>- Paiements : dates et montants<br/>- Factures dues, téléchargement PDF"]
        B5["<b>5. Compte</b><br/>- Langue"]
    end

    subgraph LOC["Application : locataire"]
        L1["<b>1. Accueil</b><br/>- Solde dû, prochaine échéance<br/>- Dernière demande de maintenance"]
        L2["<b>2. Mon bail</b><br/>- Logement, dates, loyer et rythme<br/>- Caution<br/>- Échéancier avec le statut de chaque ligne"]
        L3["<b>3. Factures et reçus</b><br/>- À payer, payées<br/>- Détail, téléchargement PDF"]
        L4["<b>4. Maintenance</b><br/>- Nouvelle demande avec photo<br/>- Liste des demandes et statut"]
        L5["<b>5. Compte</b><br/>- Langue"]
    end

    %% Mise en service
    D1 -.->|Si biens de tiers| D2
    D2 --> D3
    D3 --> D4
    D4 -.->|Invitation| MAIL
    MAIL -.->|Lien| C0
    DSK -.->|Même compte| C0
    C0 -->|Property Manager : tous les biens| B1
    C0 -->|Bailleur tiers : ses biens| B1
    C0 -->|Rôle Locataire| L1

    %% Parcours gestionnaire et bailleur
    B1 -->|Mes biens| B2
    B2 -->|Un bien| B3
    B3 -->|Un locataire| B4
    B1 -->|Facture en retard| B4
    B1 -.-> B5

    %% Parcours locataire
    L1 -->|Mon bail| L2
    L1 -->|Factures| L3
    L1 -->|Maintenance| L4
    L1 -.-> L5

    %% Données qui changent
    D3 ==>|Nouvelle facture| L3
    D3 ==>|Nouvelle facture| B3
    D5 ==>|Facture payée, reçu| L3
    D5 ==>|Paiement visible| B4
    D5 -.->|Reçu et avis de paiement| MAIL
    D3 -.->|Rappel avant échéance| MAIL
    L4 ==>|Demande créée| D6
    D6 -.->|Statut mis à jour| L4

    LEG["<b>Lecture</b><br/>- Flèche simple : on passe d'un écran à l'autre<br/>- Flèche épaisse : une donnée change<br/>- Pointillés : e-mail, invitation ou retour d'information<br/>- Le gestionnaire voit les écrans du bailleur sur tous les biens.<br/>Pour modifier, il retourne au desk."]

    class D1,D2,D3,D4,D5,D6 desk
    class B1,B2,B3,B4,B5 bailleur
    class L1,L2,L3,L4,L5 locataire
    class C0,MAIL commun
    class LEG legende
    style DSK fill:#faf8fd,stroke:#7a5bc0,stroke-width:1px
    style BAI fill:#f7f9fe,stroke:#3b6fd6,stroke-width:1px
    style LOC fill:#f5fbf8,stroke:#2e8b62,stroke-width:1px
